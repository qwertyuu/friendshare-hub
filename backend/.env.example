# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8080

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/raphartage_club

# Auth
JWT_SECRET=change-me-to-random-string-min-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
MAX_FILES_PER_ITEM=10

# Admin (first user with this email becomes admin)
ADMIN_EMAIL=your-email@example.com

# CORS
CORS_ORIGIN=http://localhost:8080

# Email Configuration
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@friendshare.com
SMTP_FROM_NAME=FriendShare Hub
